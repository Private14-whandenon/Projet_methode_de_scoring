data_new <- data_new %>%
rename_with(~ str_replace_all(., "\\s+", "_"))
# On convertit les variables catégorielles (binaires et ordinales) en facteurs
data_new <- data_new %>%
mutate(
across(any_of(c("Churn", "Complains", "Status", "Tariff.Plan")), as.factor),
Age.Group=factor(Age.Group, levels = 1:5, ordered=TRUE),
Charge..Amount = factor(Charge..Amount, levels = 0:9, ordered = TRUE)
)
# Vérification
str(data_new)
View(data)
boxplot(select(data_new, where(is.numeric)))
df <- data_new[data_new$Seconds.of.Use> 15000]
df <- data_new[data_new$Seconds.of.Use > 15000,]
View(df)
View(df)
data_new$Seconds.of.Use_min <- data_new[data_new$Seconds.of.Use > 15000,]/3600
df <- data_new[data_new$Seconds.of.Use > 15000,]
df$Seconds.of.Use_min <- df[df$Seconds.of.Use > 15000,]/3600
df$Seconds.of.Use_min <- df$Seconds.of.Use/3600
View(df)
View(df)
df$Seconds.of.Use_min <- df$Seconds.of.Use/60
