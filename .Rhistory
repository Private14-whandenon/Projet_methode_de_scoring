#L'encodage se fera uniquement sur les variables catégorielles binaires. Les variable catégorielles ordinales seront reconverties en numériques, uniquement pour les algorithmes KNN, K-means et CAH.
numeric_vars <- names(dplyr::select(data_new, where(is.numeric)))
cat_ordinal_vars <- c("Charge..Amount", "Age.Group")
#df_cat_ordinal_vars <- (data_new[, cat_ordinal_vars])
data_new[cat_ordinal_vars] <- lapply(data_new[cat_ordinal_vars], function(x) as.numeric(as.character(x)))
df_nominales <- data_new[, c("Complains", "Tariff.Plan", "Status")]
#Appliquer le One-Hot Encoding
mat_onehot <- model.matrix(~ . - 1, data = df_nominales)
# 3. Regrouper avec tes quantitatives et tes ordinales déjà numériques
df_global <- cbind(
data_new[, c(numeric_vars, cat_ordinal_vars)], # Quantitatives + Ordinales numériques
mat_onehot                               # Nominales encodées en 0/1
)
str(df_global)
View(df_global)
