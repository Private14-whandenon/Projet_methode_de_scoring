library(readr)
library(MASS)
library(tidyverse)
library(dplyr)
library(stringr)
library(ggplot2)
library(cluster)
library(factoextra)
library(dendextend)
library(corrplot)
library(caret)
library(klaR)
library(randomForest)
library(vcd)
data <- read.csv("Customer Churn.csv")
#Aperçu des premières lignes
head(data)
#Aperçu des informations du dataset (nb de variables et d'observations, noms et types de variables)
str(data)
#rm(list = ls())
#Traitement des valeurs manquantes
nb_miss_value <- sum(is.na(data))
print(paste("Nombre de valeurs manquantes trouvées :",nb_miss_value))
#Traitement des doublons
##Détection des doublons
nb_doublons <- sum(duplicated(data))
print(paste("Nombre de doublons trouvés :",nb_doublons))
##Suppression des doublons et création d'un nouveau dataset sans les doublons (j'avais trouvé 300 doublons):
data_new <- data %>% distinct()
#Standardisation des noms des variables :
data_new <- data_new %>%
rename_with(~ str_replace_all(., "\\s+", "_"))
#On convertit les variables catégorielles (binaires et ordinales) en facteurs
data_new <- data_new %>%
mutate(
across(any_of(c("Churn", "Complains", "Status", "Tariff.Plan")), as.factor),
Age.Group=factor(Age.Group, levels = 1:5, ordered=TRUE),
Charge..Amount = factor(Charge..Amount, levels = 0:10, ordered = TRUE)
)
#Vérification
str(data_new)
#Traitement des valeurs aberrantes
##Détection des valeurs abérrantes (graphiquement)
boxplot(dplyr::select(data_new, where(is.numeric)))
#Sélection des variables
numeric_vars <- names(dplyr::select(data_new, where(is.numeric)))
#Statistiques descriptives des variables
summary(data_new[numeric_vars])
#Boxplot, histogramme et QQ-plot des variables
for(i in numeric_vars) {
boxplot(data_new[[i]], main=paste("boxplot de", i))
hist(data_new[[i]], probability = TRUE, main= paste("Histogramme et de densité de", i), xlab = i)
lines(density(data_new[[i]], na.rm = TRUE), col = "red", lwd = 2)
qqnorm(data_new[[i]], main = paste("QQ_plot de",i), col = "lightblue")
qqline(data_new[[i]], lwd=2)
}
#rm(list = ls())
#Traitement des valeurs manquantes
nb_miss_value <- sum(is.na(data))
print(paste("Nombre de valeurs manquantes trouvées :",nb_miss_value))
#Traitement des doublons
##Détection des doublons
nb_doublons <- sum(duplicated(data))
print(paste("Nombre de doublons trouvés :",nb_doublons))
##Suppression des doublons et création d'un nouveau dataset sans les doublons (j'avais trouvé 300 doublons):
data_new <- data %>% distinct()
#Standardisation des noms des variables :
data_new <- data_new %>%
rename_with(~ str_replace_all(., "\\s+", "_"))
#On convertit les variables catégorielles (binaires et ordinales) en facteurs
data_new <- data_new %>%
mutate(
across(any_of(c("Churn", "Complains", "Status", "Tariff.Plan")), as.factor),
#Age.Group=factor(Age.Group, levels = 1:5, ordered=TRUE),
#Charge..Amount = factor(Charge..Amount, levels = 0:10, ordered = TRUE)
)
#Vérification
str(data_new)
#Traitement des valeurs aberrantes
##Détection des valeurs abérrantes (graphiquement)
boxplot(dplyr::select(data_new, where(is.numeric)))
#Sélection des variables
numeric_vars <- names(dplyr::select(data_new, where(is.numeric)))
#Statistiques descriptives des variables
summary(data_new[numeric_vars])
#Boxplot, histogramme et QQ-plot des variables
for(i in numeric_vars) {
boxplot(data_new[[i]], main=paste("boxplot de", i))
hist(data_new[[i]], probability = TRUE, main= paste("Histogramme et de densité de", i), xlab = i)
lines(density(data_new[[i]], na.rm = TRUE), col = "red", lwd = 2)
qqnorm(data_new[[i]], main = paste("QQ_plot de",i), col = "lightblue")
qqline(data_new[[i]], lwd=2)
}
#Selection de variables catégorielles
categories_vars <- names(dplyr::select(data_new, where(is.factor)))
#Tableaux des fréquences et diagrammes des variables catégorielles
for (x in categories_vars) {
counts <- table(data_new[x])
#Tableaux de fréquence
props <- prop.table(counts)*100
print(props)
#Diagrammes
bp <- barplot(counts,
main=paste("Diagramme de",x),
xlab = x,
ylab = "Effectifs",
col = "lightblue",
ylim= c(0, max(counts)*1.5))
#Faire apparaître l'effectif et la fréquence de chaque variable au niveau de la barre
labels_texte <- paste0(counts, " \n(", round(props, 1), "%)")
text(x = bp,
y = counts,
labels = labels_texte,
pos = 3,      # Positionne le texte juste au-dessus du sommet de la barre
cex = 0.85,   # Taille de la police (légèrement réduite pour que ça tienne bien)
col = "darkblue")
}
numeric_vars <- names(dplyr::select(data_new, where(is.numeric)))
#Boxplots des moyennes des variables quantitatives en fonction du churn
aggregate(data_new[, numeric_vars], list(Churn = data_new$Churn), mean)
par(mfrow = c(2, 4))
for (v in numeric_vars) boxplot(data_new[[v]] ~ data_new$Churn, main = v, xlab = "", ylab = "")
par(mfrow = c(1, 1))
# Correlation des varaibles quantitatives
df_num <- data_new[, numeric_vars]
mat_pearson  <- cor(df_num, method = "pearson", use = "complete.obs")
mat_spearman <- cor(df_num, method = "spearman", use = "complete.obs")
corrplot(mat_pearson, method = "color", type = "upper", addCoef.col = "black", number.cex = 0.6, title = "Heatmap de corrélation (pearson)", mar = c(0,0,1,0))
corrplot(mat_spearman, method = "color", type = "upper", addCoef.col = "black", number.cex = 0.6, title = "Heatmap de corrélation (spearman)", mar = c(0,0,1,0))
#Commentaire: La correlation de spearman est plus robuste étant donné que nos variables ne suivent pas une distribution normale (cf histogramme et qq_plot) et qu'il y a des valeurs extrêmes.
categories_vars <- names(dplyr::select(data_new, where(is.factor)))
#Créez une matrice vide carrée (N x N)
n <- length(categories_vars)
mat_cramer <- matrix(0, nrow = n, ncol = n, dimnames = list(categories_vars, categories_vars))
#Remplir la matrice avec le V de Cramér pour chaque paire
for (i in 1:n) {
for (j in 1:n) {
if (i == j) {
mat_cramer[i, j] <- 1.0 # Une variable associée à elle-même a un V de 1
} else {
tab <- table(data_new[[categories_vars[i]]], data_new[[categories_vars[j]]])
mat_cramer[i, j] <- assocstats(tab)$cramer
}
}
}
# 4. Affichage sous forme de heatmap avec corrplot
corrplot(mat_cramer,
method = "color",
type = "upper",
addCoef.col = "black",
number.cex = 0.7,
tl.col = "black",
tl.srt = 45,
title = "Matrice du V de Cramér (liaisons entre qualitatives)",
mar = c(0, 0, 2, 0))
#rm(list = ls())
#Traitement des valeurs manquantes
nb_miss_value <- sum(is.na(data))
print(paste("Nombre de valeurs manquantes trouvées :",nb_miss_value))
#Traitement des doublons
##Détection des doublons
nb_doublons <- sum(duplicated(data))
print(paste("Nombre de doublons trouvés :",nb_doublons))
##Suppression des doublons et création d'un nouveau dataset sans les doublons (j'avais trouvé 300 doublons):
data_new <- data %>% distinct()
#Standardisation des noms des variables :
data_new <- data_new %>%
rename_with(~ str_replace_all(., "\\s+", "_"))
#On convertit les variables catégorielles (binaires et ordinales) en facteurs
data_new <- data_new %>%
mutate(
across(any_of(c("Churn", "Complains", "Status", "Tariff.Plan")), as.factor),
Age.Group=factor(Age.Group, levels = 1:5, ordered=TRUE),
Charge..Amount = factor(Charge..Amount, levels = 0:10, ordered = TRUE)
)
#Vérification
str(data_new)
#Traitement des valeurs aberrantes
##Détection des valeurs abérrantes (graphiquement)
boxplot(dplyr::select(data_new, where(is.numeric)))
#L'encodage se fera uniquement sur les variables catégorielles binaires. Les variable catégorielles ordinales seront reconverties en numériques, uniquement pour les algorithmes KNN, K-means et CAH.
numeric_vars <- names(dplyr::select(data_new, where(is.numeric)))
#cat_ordinal_vars <- c("Charge..Amount", "Age.Group")
data_new[cat_ordinal_vars] <- lapply(data_new[cat_ordinal_vars], function(x) as.numeric(as.character(x)))
#L'encodage se fera uniquement sur les variables catégorielles binaires. Les variable catégorielles ordinales seront reconverties en numériques, uniquement pour les algorithmes KNN, K-means et CAH.
numeric_vars <- names(dplyr::select(data_new, where(is.numeric)))
#cat_ordinal_vars <- c("Charge..Amount", "Age.Group")
#data_new[cat_ordinal_vars] <- lapply(data_new[cat_ordinal_vars], function(x) as.numeric(as.character(x)))
df_nominales <- data_new[, c("Complains", "Tariff.Plan", "Status")]
#Appliquer le One-Hot Encoding
mat_onehot <- model.matrix(~ . - 1, data = df_nominales)
# 3. Regrouper avec tes quantitatives et tes ordinales déjà numériques
df_global <- cbind(
data_new[, numeric_vars], # Quantitatives + Ordinales numériques
mat_onehot                               # Nominales encodées en 0/1
)
str(df_global)
View(df_global)
View(df_global)
View(data_new)
View(data)
View(data)
#L'encodage se fera uniquement sur les variables catégorielles binaires. Les variable catégorielles ordinales seront reconverties en numériques, uniquement pour les algorithmes KNN, K-means et CAH.
numeric_vars <- names(dplyr::select(data_new, where(is.numeric)))
cat_ordinal_vars <- c("Charge..Amount", "Age.Group")
data_new[cat_ordinal_vars] <- lapply(data_new[cat_ordinal_vars], function(x) as.numeric(as.character(x)))
df_nominales <- data_new[, c("Complains", "Tariff.Plan", "Status")]
#Appliquer le One-Hot Encoding
mat_onehot <- model.matrix(~ . - 1, data = df_nominales)
# 3. Regrouper avec tes quantitatives et tes ordinales déjà numériques
df_global <- cbind(
data_new[, c(numeric_vars, cat_ordinal_vars)], # Quantitatives + Ordinales numériques
mat_onehot                               # Nominales encodées en 0/1
)
str(df_global)
View(df_global)
